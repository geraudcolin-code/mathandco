{
  "name": "mathandco",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Les fichiers du site sont servis tels quels ; le Worker ne répond qu'aux adresses sans fichier (/api/quiz-notes :
  // résultats chiffrés des quiz notés, 15 nov. 2026).
  "main": "worker/notes.js",
  "assets": {
    "directory": "./"
  },
  // Base D1 des résultats, créée par M. Colin dans le tableau de bord Cloudflare (15 nov. 2026).
  "d1_databases": [
    { "binding": "DB", "database_name": "mathandco-notes", "database_id": "f9c300ad-43d1-4398-9597-6d7de6857c00" }
  ]
}
